# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required in production (HTTPS admin + forms behind Traefik)
# CSRF_TRUSTED_ORIGINS=https://api.durus.example.com

# PostgreSQL
POSTGRES_DB=durus
POSTGRES_USER=durus
POSTGRES_PASSWORD=durus
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# Ports (docker compose dev only — not used in production)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Production (docker-compose.prod.yml + Traefik)
# FRONTEND_DOMAIN=durus.example.com
# API_DOMAIN=api.durus.example.com
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=letsencrypt
#
# Example production values:
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<long-random-secret>
# DJANGO_ALLOWED_HOSTS=api.durus.example.com
# CORS_ALLOWED_ORIGINS=https://durus.example.com
# CSRF_TRUSTED_ORIGINS=https://api.durus.example.com
# POSTGRES_PASSWORD=<strong-password>
# VITE_API_BASE_URL=https://api.durus.example.com

# Telegram (étape 3+) — regenerate api_hash on my.telegram.org if previously exposed
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNEL_ID=-1001087177387
TELEGRAM_CHANNEL_USERNAME=durusustazalhusaynba
TELEGRAM_SESSION_PATH=/app/sessions/durus

# Cloudflare R2 (private bucket) — media storage
R2_ACCOUNT_ID=1aeefec8c9f2c56b25f219548037bfec
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=durusustazalhusaynba
# Leave R2_ENDPOINT empty to derive it from R2_ACCOUNT_ID
R2_ENDPOINT=
R2_REGION=auto
R2_PRESIGNED_URL_TTL=3600

# Worker (media download loop)
WORKER_BATCH_SIZE=2
WORKER_INTERVAL_SECONDS=900

# Discord error alerts (server-side webhook — never expose as VITE_*)
# Create via Discord channel → Integrations → Webhooks
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
